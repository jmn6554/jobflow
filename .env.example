# Copy to .env. Never commit your completed .env, profile, resume or browser data.
JOBFLOW_DB=data/jobflow.db
JOBFLOW_CONFIG=config/daily.json
JOBFLOW_DISCOVERY_SOURCES=greenhouse,lever,ashby
# Comma-separated Company:board-token entries. Choose actual employer boards.
JOBFLOW_GREENHOUSE_BOARDS=
JOBFLOW_LEVER_SITES=
JOBFLOW_ASHBY_BOARDS=
# Optional CSV registries (company,board_token):
JOBFLOW_GREENHOUSE_REGISTRY=
JOBFLOW_LEVER_REGISTRY=
JOBFLOW_ASHBY_REGISTRY=
JOBFLOW_APPLICATION_PROFILE=private-data/application-profile.json
JOBFLOW_APPLICATION_RESUME=private-data/resume.docx
JOBFLOW_BROWSER_PROFILE=private-data/browser-profile
JOBFLOW_ASSIST_NATIVE_CHROME=false
# All model-assisted features default off. No local model integration is included.
JOBFLOW_APPLICATION_AI_ENABLED=false
JOBFLOW_RESUME_PROVIDER=disabled
# Optional paid cloud features require explicit enablement AND your own model/key.
OPENAI_API_KEY=
JOBFLOW_OPENAI_MODEL=
JOBFLOW_OPENAI_REASONING=medium
# Optional Gmail verification; create your own OAuth desktop client.
JOBFLOW_GMAIL_CLIENT_SECRET=private-data/gmail-client.json
JOBFLOW_GMAIL_TOKEN=private-data/gmail-token.json
